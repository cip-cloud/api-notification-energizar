# Odoo (requeridas — la API no arranca sin estas)
ODOO_URL=https://tu-odoo.ejemplo.com
ODOO_DB=nombre_de_la_base
ODOO_USER=usuario@ejemplo.com
ODOO_PASSWORD=clave-o-vacio-si-usas-api-key
# ODOO_API_KEY=clave-de-aplicacion   # tiene prioridad sobre ODOO_PASSWORD

# Opcionales
# ODOO_TIMEOUT=30
# TZ=America/Bogota
# ENABLE_SCHEDULER=true      # false en Cloud Run: el disparo lo hace Cloud Scheduler por HTTP
# CRON_HOUR=8
# CRON_MINUTE=0
# ACTIVITY_HORIZON_DAYS=15   # días hacia adelante que se muestran las actividades
# SKIP_HOLIDAYS=true       # true = no envía en días festivos colombianos
# SATURDAY_IS_WORKING=false  # true = envía sábados, false = no
# REMINDER_SENDER=CRM Comercial <crm@ejemplo.com>
# DB_URL=sqlite+aiosqlite:///data/reminder_logs.db

# SMTP — servidor de correo del cliente (requerido para enviar los recordatorios)
# El remitente (From) que ven los vendedores es REMINDER_SENDER (arriba).
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_USER=notificaciones@ejemplo.com
SMTP_PASSWORD=clave-del-buzon
# SMTP_STARTTLS=true   # true = STARTTLS (puerto 587, lo usual)
# SMTP_SSL=false       # true = SSL implícito (puerto 465); excluye STARTTLS
